{
  "name": "rgodbeat-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "auth:set-admin": "tsx scripts/set-admin-password.ts",
    "sync:library": "node --env-file=.env.local --import tsx scripts/sync-companion.ts",
    "sync:watch": "node --env-file=.env.local --import tsx scripts/sync-companion.ts --watch",
    "sync:install": "node --env-file=.env.local --import tsx scripts/install-library-sync.ts",
    "sync:status": "node --import tsx scripts/install-library-sync.ts --status",
    "sync:stop": "node --import tsx scripts/install-library-sync.ts --stop"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@stripe/react-stripe-js": "^6.11.0",
    "@stripe/stripe-js": "^9.17.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
